{
    "name": "fastlane-course-planner",
    "displayName": "Fastlane Course Planner",
    "version": "1.0.0",
    "description": "Independent UT Austin planner: inline grade %, async & conflict highlights, ranked backups, local IDA import, registration helper.",
    "private": true,
    "homepage": "https://github.com/SimpSlader/Longhorn-Fastlane-Plus",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsgo && vite build",
        "build:dev": "tsgo && NODE_ENV='development' vite build --mode development",
        "build:watch": "NODE_ENV='development' vite build --mode development -w",
        "zip": "pnpm build && pnpm gulp zipProdBuild",
        "zip:to-publish": "SENTRY_ENV='production' pnpm zip",
        "format": "biome format",
        "format:fix": "biome format --write",
        "lint": "biome lint",
        "lint:fix": "biome lint --write",
        "check": "biome check",
        "check:fix": "biome check --write",
        "check-types": "tsgo --noEmit",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "coverage": "vitest run --coverage",
        "preview": "vite preview",
        "generate-changelog": "bun run scripts/generateChangelog.ts",
        "preinstall": "npx only-allow pnpm",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "prepare": "husky",
        "test:run": "vitest run",
        "data:manifest": "node scripts/fastlane/dataset-manifest.mjs",
        "data:check": "node scripts/fastlane/dataset-manifest.mjs --check",
        "security:check": "node scripts/fastlane/security-check.mjs dist",
        "package:fastlane": "node scripts/fastlane/third-party-notices.mjs && pnpm build && node scripts/fastlane/security-check.mjs dist && node scripts/fastlane/package.mjs",
        "notices": "node scripts/fastlane/third-party-notices.mjs",
        "e2e": "playwright test"
    },
    "dependencies": {
        "@date-fns/tz": "^1.4.1",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@headlessui/react": "^2.2.10",
        "@octokit/rest": "^22.0.1",
        "@sentry/react": "^10.47.0",
        "@tanstack/react-query": "^5.96.2",
        "@tsparticles/engine": "^3.9.1",
        "@tsparticles/react": "^3.0.0",
        "@tsparticles/slim": "^3.9.1",
        "@typescript/native-preview": "7.0.0-dev.20260707.2",
        "@unocss/vite": "^66.6.8",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "html-to-image": "^1.11.13",
        "nanoid": "^5.1.7",
        "pdfjs-dist": "4.10.38",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-loading-skeleton": "^3.5.0",
        "react-markdown": "^10.1.0",
        "react-syntax-highlighter": "^16.1.1",
        "remark-gfm": "^4.0.1",
        "sql.js": "1.14.1"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.10",
        "@chromatic-com/storybook": "^5.3.0",
        "@commitlint/cli": "^20.5.0",
        "@commitlint/config-conventional": "^20.5.0",
        "@commitlint/types": "^20.5.0",
        "@crxjs/vite-plugin": "2.4.0",
        "@iconify-json/iconoir": "^1.2.10",
        "@iconify-json/material-symbols": "^1.2.65",
        "@iconify-json/ph": "^1.2.2",
        "@playwright/test": "^1.64.1",
        "@semantic-release/exec": "^7.1.0",
        "@sentry/toolbar": "1.0.0-beta.11",
        "@storybook/addon-designs": "^11.1.4",
        "@storybook/addon-docs": "^10.5.8",
        "@storybook/react": "^10.5.8",
        "@storybook/react-vite": "^10.5.8",
        "@svgr/plugin-jsx": "^8.1.0",
        "@types/chrome": "^0.1.39",
        "@types/conventional-changelog": "^6.0.1",
        "@types/gulp": "^4.0.18",
        "@types/gulp-zip": "^4.0.4",
        "@types/node": "^25.5.2",
        "@types/prompts": "^2.4.9",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@types/react-syntax-highlighter": "^15.5.13",
        "@types/sql.js": "^1.4.11",
        "@unocss/postcss": "^66.6.8",
        "@unocss/preset-uno": "^66.6.8",
        "@unocss/preset-web-fonts": "^66.6.8",
        "@unocss/reset": "^66.6.8",
        "@unocss/transformer-directives": "^66.6.8",
        "@unocss/transformer-variant-group": "^66.6.8",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitest/coverage-v8": "^4.1.3",
        "@vitest/ui": "^4.1.3",
        "chalk": "^5.6.2",
        "chromatic": "^16.1.0",
        "conventional-changelog": "^7.2.0",
        "fake-indexeddb": "^6.2.6",
        "fast-deep-equal": "^3.1.3",
        "gulp": "^5.0.1",
        "gulp-execa": "^8.0.1",
        "gulp-zip": "^6.1.0",
        "husky": "^9.1.7",
        "jsdom": "^29.0.2",
        "prompts": "^2.4.2",
        "react-scan": "^0.5.3",
        "sass": "^1.99.0",
        "semantic-release": "^25.0.3",
        "simple-git": "^3.35.2",
        "storybook": "^10.5.8",
        "typescript": "^6.0.2",
        "unocss": "^66.6.8",
        "unocss-preset-primitives": "0.0.2-beta.2",
        "unplugin-icons": "^23.0.1",
        "vite": "^8.0.7",
        "vite-plugin-react-fallback-throttle": "^0.1.3",
        "vitest": "^4.1.3"
    },
    "engineStrict": true,
    "engines": {
        "node": "^24.14",
        "pnpm": "^10"
    },
    "pnpm": {
        "patchedDependencies": {
            "@crxjs/vite-plugin@2.4.0": "patches/@crxjs__vite-plugin@2.4.0.patch"
        },
        "overrides": {},
        "onlyBuiltDependencies": []
    },
    "packageManager": "pnpm@10.33.0",
    "upstream": {
        "utRegistrationPlus": {
            "repo": "https://github.com/Longhorn-Developers/UT-Registration-Plus",
            "version": "2.4.1",
            "commit": "1e3f278"
        },
        "degreeAuditPlus": {
            "repo": "https://github.com/Longhorn-Developers/Degree-Audit-Plus",
            "commit": "83e02658931908e062f3b3217da7d8e836d888cc"
        }
    }
}
